            "text": "{\n  \"author_templates\": {\n    \"name\": \"author_templates\",\n    \"label\": \"Шаблоны текущего пользователя\",\n    \"description\": \"Шаблоны текущего пользователя\",\n    \"inactive\": false,\n    \"parameters\": [],\n    \"group\": null\n  },\n  \"collegial_group\": {\n    \"name\": \"collegial_group\",\n    \"label\": \"Коллегиальные документы\",\n    \"description\": \"Группировка коллегиальных документов\",\n    \"inactive\": false,\n    \"parameters\": [\n      {\n        \"name\": \"group_board_documents\",\n        \"description\": \"Сгруппировать Документы Правления\",\n        \"stringValue\": null,\n        \"booleanValue\": true,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": null\n      },\n      {\n        \"name\": \"group_committee_documents\",\n        \"description\": \"Сгруппировать Документы Комитетов\",\n        \"stringValue\": null,\n        \"booleanValue\": true,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": null\n      },\n      {\n        \"name\": \"group_directors_documents\",\n        \"description\": \"Сгруппировать Документы СД\",\n        \"stringValue\": null,\n        \"booleanValue\": true,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": null\n      }\n    ],\n    \"group\": null\n  },\n  \"report_designer\": {\n    \"name\": \"report_designer\",\n    \"label\": \"Конструктор отчетов\",\n    \"description\": \"Конструктор отчетов\",\n    \"inactive\": false,\n    \"parameters\": [\n      {\n        \"name\": \"group_access\",\n        \"description\": \"Группы доступа\",\n        \"stringValue\": \"\",\n        \"booleanValue\": true,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": \"ddt_group\"\n      }\n    ],\n    \"group\": null\n  },\n  \"important_documents\": {\n    \"name\": \"important_documents\",\n    \"label\": \"Важные документы\",\n    \"description\": \"Видимость модуля «Важные документы»\",\n    \"inactive\": false,\n    \"parameters\": [\n      {\n        \"name\": \"color_application_reject\",\n        \"description\": \"Цветовое применение Отклонения\",\n        \"stringValue\": \"\",\n        \"booleanValue\": false,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": \"ddt_color_application_reject\"\n      }\n    ],\n    \"group\": null\n  },\n  \"r7\": {\n    \"name\": \"r7\",\n    \"label\": \"Интеграция с Р7 Офис\",\n    \"description\": \"Интеграция с Р7 Офис\",\n    \"inactive\": false,\n    \"parameters\": [],\n    \"group\": null\n  },\n  \"rushydro_routing\": {\n    \"name\": \"rushydro_routing\",\n    \"label\": \"Маршрутизация РусГидро\",\n    \"description\": \"Маршрутизация РусГидро\",\n    \"inactive\": true,\n    \"parameters\": [],\n    \"group\": null\n  },\n  \"language\": {\n    \"name\": \"language\",\n    \"label\": \"Выбор языка\",\n    \"description\": \"Отображение в настройках пользователя выбора языка Системы «Выбор языка»\",\n    \"inactive\": false,\n    \"parameters\": [\n      {\n        \"name\": \"settings_select_language\",\n        \"description\": \"Настройки - «Выбор языка»\",\n        \"stringValue\": null,\n        \"booleanValue\": false,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": null\n      }\n    ],\n    \"group\": null\n  },\n  \"eehd_integration\": {\n    \"name\": \"eehd_integration\",\n    \"label\": \"ЕЭХД\",\n    \"description\": \"Интеграция c ЕЭХД\",\n    \"inactive\": true,\n    \"parameters\": [],\n    \"group\": \"integrations\"\n  },\n  \"EDO\": {\n    \"name\": \"EDO\",\n    \"label\": \"ЮЗЭДО\",\n    \"description\": \"Управление отображением папок для модуля ЮЗЭДО\",\n    \"inactive\": true,\n    \"parameters\": [],\n    \"group\": \"integrations\"\n  },\n  \"nomenclature\": {\n    \"name\": \"nomenclature\",\n    \"label\": \"Номенклатура дел\",\n    \"description\": \"Видимость раздела «НД» в дереве навигации\",\n    \"inactive\": false,\n    \"parameters\": [],\n    \"group\": null\n  },\n  \"linking_proxy_and_contract\": {\n    \"name\": \"linking_proxy_and_contract\",\n    \"label\": \"Связь между доверенностью и проектом договорного документа\",\n    \"description\": \"Проверка наличия доверенности в связанных документах проекта договора\",\n    \"inactive\": true,\n    \"parameters\": [\n      {\n        \"name\": \"doc_type\",\n        \"description\": \"Типы документов\",\n        \"stringValue\": null,\n        \"booleanValue\": false,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": null\n      }\n    ],\n    \"group\": null\n  },\n  \"fulltext_dbrain\": {\n    \"name\": \"fulltext_dbrain\",\n    \"label\": \"Распознавание текста\",\n    \"description\": \"Возможность автоматического  распознавание текста\",\n    \"inactive\": false,\n    \"parameters\": [],\n    \"group\": null\n  },\n  \"hide_deputy_task\": {\n    \"name\": \"hide_deputy_task\",\n    \"label\": \"Скрывать помощника в задании\",\n    \"description\": \"Скрывать информацию о помощнике/заместителе, завершившем задание\",\n    \"inactive\": true,\n    \"parameters\": [],\n    \"group\": null\n  },\n  \"print_reg_stamp\": {\n    \"name\": \"print_reg_stamp\",\n    \"label\": \"Печать регистрационного штампа\",\n    \"description\": \"Возможность печати регистрационных данных (даты, номера) и данных о подписании на контенте\",\n    \"inactive\": false,\n    \"parameters\": [\n      {\n        \"name\": \"reg_stamp_position\",\n        \"description\": \"Расположение рег. штампа\",\n        \"stringValue\": \"every\",\n        \"booleanValue\": false,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": \"ddt_dict_reg_stamp_position\"\n      },\n      {\n        \"name\": \"reg_stamp_color\",\n        \"description\": \"Цвет рег. штампа\",\n        \"stringValue\": \"#000000\",\n        \"booleanValue\": false,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": \"ddt_dict_reg_stamp_color\"\n      },\n      {\n        \"name\": \"display_signer\",\n        \"description\": \"Подписано в СЭДО\",\n        \"stringValue\": null,\n        \"booleanValue\": true,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": null\n      },\n      {\n        \"name\": \"id_stamp\",\n        \"description\": \"Идентификатор в штампе\",\n        \"stringValue\": null,\n        \"booleanValue\": true,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": null\n      }\n    ],\n    \"group\": null\n  },\n  \"chat_addons\": {\n    \"name\": \"chat_addons\",\n    \"label\": \"Дополнение к чату\",\n    \"description\": \"Дополнительные обработчики сообщений из чата\",\n    \"inactive\": true,\n    \"parameters\": [],\n    \"group\": null\n  },\n  \"pg_lock\": {\n    \"name\": \"pg_lock\",\n    \"label\": \"Защита запросов от параллельных транзакций\",\n    \"description\": \"Защита запросов от параллельных транзакций\",\n    \"inactive\": false,\n    \"parameters\": [],\n    \"group\": null\n  },\n  \"1C_CRM_incoming\": {\n    \"name\": \"1C_CRM_incoming\",\n    \"label\": \"Интеграция 1С CRM для входящих\",\n    \"description\": \"Интеграция с 1С CRM для передачи входящего документа с карточкой и связанными документами. Для корректной работы модуля необходима донастройка входящих документов.\",\n    \"inactive\": true,\n    \"parameters\": [],\n    \"group\": \"integrations\"\n  },\n  \"upsd\": {\n    \"name\": \"upsd\",\n    \"label\": \"Модуль для УПСД\",\n    \"description\": \"Видимость модуля для УПСД\",\n    \"inactive\": false,\n    \"parameters\": [],\n    \"group\": null\n  },\n  \"fsk_routing\": {\n    \"name\": \"fsk_routing\",\n    \"label\": \"Маршрутизация ФСК\",\n    \"description\": \"Маршрутизация ФСК\",\n    \"inactive\": false,\n    \"parameters\": [],\n    \"group\": null\n  },\n  \"batch_mail\": {\n    \"name\": \"batch_mail\",\n    \"label\": \"Партионная почта\",\n    \"description\": \"Возможность формирования  сопроводительных документов для отправки корреспонденции ФГУП «Почта России»\",\n    \"inactive\": true,\n    \"parameters\": [],\n    \"group\": null\n  },\n  \"print_card_settings\": {\n    \"name\": \"print_card_settings\",\n    \"label\": \"Печатная форма РК\",\n    \"description\": \"Настройки печатной карточки документа\",\n    \"inactive\": false,\n    \"parameters\": [\n      {\n        \"name\": \"default_format\",\n        \"description\": \"Формат по умолчанию\",\n        \"stringValue\": \"pdf\",\n        \"booleanValue\": false,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": \"ddt_dict_print_card_format\"\n      },\n      {\n        \"name\": \"all_tabs\",\n        \"description\": \"Выделение всех вкладок\",\n        \"stringValue\": null,\n        \"booleanValue\": true,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": null\n      },\n      {\n        \"name\": \"view_applications_without_versions\",\n        \"description\": \"Отображать приложения без версий\",\n        \"stringValue\": null,\n        \"booleanValue\": false,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": null\n      },\n      {\n        \"name\": \"show_applications_and_versions\",\n        \"description\": \"Отображать приложения и версии одновременно\",\n        \"stringValue\": null,\n        \"booleanValue\": true,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": null\n      }\n    ],\n    \"group\": null\n  },\n  \"asu_fhd_link\": {\n    \"name\": \"asu_fhd_link\",\n    \"label\": \"Добавление связанных документов из АСУ ФХД\",\n    \"description\": \"Интеграция с ПКУЭК\",\n    \"inactive\": true,\n    \"parameters\": [],\n    \"group\": \"integrations\"\n  },\n  \"agent_validate_inn_kpp_ogrn\": {\n    \"name\": \"agent_validate_inn_kpp_ogrn\",\n    \"label\": \"Валидация атрибутов справочника Корреспондента по трём поля: ИНН, КПП и ОГРН\",\n    \"description\": \"Работа со справочником Корреспондент. Проверка создаваемых агентов на дубли по трём полям: ИНН, КПП и ОГРН.\",\n    \"inactive\": true,\n    \"parameters\": [],\n    \"group\": null\n  },\n  \"profile_icon\": {\n    \"name\": \"profile_icon\",\n    \"label\": \"Иконка профиля\",\n    \"description\": \"Видимость и функциональность иконки пользователя во всех разделах интерфейса\",\n    \"inactive\": true,\n    \"parameters\": [],\n    \"group\": null\n  },\n  \"purchases\": {\n    \"name\": \"purchases\",\n    \"label\": \"Модуль для закупок\",\n    \"description\": \"Видимость модуля для закупок\",\n    \"inactive\": false,\n    \"parameters\": [],\n    \"group\": null\n  },\n  \"templates\": {\n    \"name\": \"templates\",\n    \"label\": \"Шаблоны\",\n    \"description\": \"Видимость, функциональность и возможность настройки шаблонов в Системе\",\n    \"inactive\": false,\n    \"parameters\": [\n      {\n        \"name\": \"settings_templates_select\",\n        \"description\": \"Настройки - Общие/Приватные шаблоны\",\n        \"stringValue\": null,\n        \"booleanValue\": true,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": null\n      }\n    ],\n    \"group\": null\n  },\n  \"familiarization\": {\n    \"name\": \"familiarization\",\n    \"label\": \"Ознакомление\",\n    \"description\": \"Настройка параметров задания «Ознакомление»\",\n    \"inactive\": true,\n    \"parameters\": [\n      {\n        \"name\": \"dsb_disabled\",\n        \"description\": \"Без срока\",\n        \"stringValue\": null,\n        \"booleanValue\": false,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": null\n      },\n      {\n        \"name\": \"dsi_term_in_days\",\n        \"description\": \"Рабочих дней\",\n        \"stringValue\": null,\n        \"booleanValue\": false,\n        \"doubleValue\": null,\n        \"intValue\": 3,\n        \"textValue\": null,\n        \"reference\": null\n      }\n    ],\n    \"group\": null\n  },\n  \"classification\": {\n    \"name\": \"classification\",\n    \"label\": \"Настройки Классификатора\",\n    \"description\": \"Настройки отображения полей в классификаторе\",\n    \"inactive\": false,\n    \"parameters\": [\n      {\n        \"name\": \"code_required\",\n        \"description\": \"Поле «Код» обязательное\",\n        \"stringValue\": null,\n        \"booleanValue\": false,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": null\n      }\n    ],\n    \"group\": null\n  },\n  \"tags\": {\n    \"name\": \"tags\",\n    \"label\": \"Метки\",\n    \"description\": \"Видимость и функциональность раздела в дереве навигации СЭДО; поля «Метки» в РК документов; параметра «Метки» в разделе Поиск\",\n    \"inactive\": true,\n    \"parameters\": [],\n    \"group\": null\n  },\n  \"preview_and_print_unsupported\": {\n    \"name\": \"preview_and_print_unsupported\",\n    \"label\": \"Замена pdf-заглушки предпросмотра контента\",\n    \"description\": \"Замена pdf-заглушки предпросмотра контента с добавлением информации, что печать невозможна.\",\n    \"inactive\": true,\n    \"parameters\": [],\n    \"group\": null\n  },\n  \"conference_questions\": {\n    \"name\": \"conference_questions\",\n    \"label\": \"Вопросы конференции\",\n    \"description\": \"Возможность создания вопросов к конференции\",\n    \"inactive\": false,\n    \"parameters\": [],\n    \"group\": null\n  },\n  \"calendar_agenda_agreement\": {\n    \"name\": \"calendar_agenda_agreement\",\n    \"label\": \"Календарь, повестка и согласование\",\n    \"description\": \"Отображение календаря в СЭДО, вкладок «Повестка» и «Согласование»\",\n    \"inactive\": true,\n    \"parameters\": [],\n    \"group\": null\n  },\n  \"integrations\": {\n    \"name\": \"integrations\",\n    \"label\": \"Интеграции\",\n    \"description\": \"Настройки для функционала, связанного с интеграциями\",\n    \"inactive\": false,\n    \"parameters\": [],\n    \"group\": null\n  },\n  \"notifications\": {\n    \"name\": \"notifications\",\n    \"label\": \"Уведомления\",\n    \"description\": \"Настройка модулей уведомлений\",\n    \"inactive\": false,\n    \"parameters\": [\n      {\n        \"name\": \"menu_notifications_panel\",\n        \"description\": \"Отображать раздел «Уведомления» в навигации\",\n        \"stringValue\": null,\n        \"booleanValue\": true,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": null\n      }\n    ],\n    \"group\": null\n  },\n  \"content_module\": {\n    \"name\": \"content_module\",\n    \"label\": \"Настройки редактирования/сохранения контента\",\n    \"description\": \"Блок настроек редактирования и сохранения основного и дополнительного контента\",\n    \"inactive\": false,\n    \"parameters\": [\n      {\n        \"name\": \"auto_save\",\n        \"description\": \"Сохранение контента без поп-ап окна\",\n        \"stringValue\": null,\n        \"booleanValue\": true,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": null\n      },\n      {\n        \"name\": \"auto_refresh_minor_version\",\n        \"description\": \"Время проверки обновления минорной версии (в секундах)\",\n        \"stringValue\": null,\n        \"booleanValue\": false,\n        \"doubleValue\": 60.0,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": null\n      }\n    ],\n    \"group\": null\n  },\n  \"sedo_notifications\": {\n    \"name\": \"sedo_notifications\",\n    \"label\": \"Уведомления СЭДО\",\n    \"description\": \"Видимость, функциональность и возможность настройки получения системных уведомлений пользователями Системы\",\n    \"inactive\": false,\n    \"parameters\": [],\n    \"group\": \"notifications\"\n  },\n  \"integration_spark_interfax\": {\n    \"name\": \"integration_spark_interfax\",\n    \"label\": \"Проверять контрагента в СПАРК-Интерфакс\",\n    \"description\": \"Проверка существования контрагента в ЕГРБЛ/ЕГРИП через систему СПАРН-Интерфакс\",\n    \"inactive\": false,\n    \"parameters\": [\n      {\n        \"name\": \"check-agent-of-sparkinterfax\",\n        \"description\": \"Проверять контрагента в СПАРК-Интерфакс\",\n        \"stringValue\": null,\n        \"booleanValue\": true,\n        \"doubleValue\": null,\n        \"intValue\": null,\n        \"textValue\": null,\n        \"reference\": null\n      }\n    ],\n    \"group\": null\n  },\n  \"not_unique_email\": {\n    \"name\": \"not_unique_email\",\n    \"label\": \"Неуникальный e-mail для УЗ\",\n    \"description\": \"Возможность создания учетной записи с неуникальным e-mail и соответствующим предупреждающим сообщением.\",\n    \"inactive\": true,\n    \"parameters\": [],\n    \"group\": null\n  },\n  \"representation\": {\n    \"name\": \"representation\",\n    \"label\": \"Представления\",\n    \"description\": \"Отображение типов документов в блоке «Представления» в области навигации\",\n    \"inactive\": true,\n    \"parameters\": [\n      {\n        \"name\": \"block_name\",\n        \"description\": \"Наименование блока в Системе\",\n        \"stringValue\": \"Представления\",\n        \"booleanVal